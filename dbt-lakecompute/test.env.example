# Functional tests run against a live lake compute endpoint. When these are unset, they skip.
DBT_COMPUTE_BASE_URL=https://api.lake-compute.fivetran.com/

# A Fivetran personal access token (`dct_...`). These are exchanged for a session rather than
# sent as a bearer token, so the suite uses `method: fivetran`. A plain service bearer token
# goes in DBT_COMPUTE_AUTH_TOKEN too, with DBT_COMPUTE_AUTH_METHOD=token alongside it.
DBT_COMPUTE_AUTH_TOKEN=
DBT_COMPUTE_AUTH_METHOD=fivetran

# The catalog to run against. Required; the tests create and drop their own schemas inside it.
DBT_COMPUTE_DATABASE=

# Optional. Pins every test to one scratch schema rather than the generated
# `test{timestamp}{pid}_{file}` name, so a shared catalog does not accumulate a namespace per
# test file. Pinning it means test classes cannot run in parallel -- pass `-n0`.
DBT_COMPUTE_SCHEMA=
